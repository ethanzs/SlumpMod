// XangMod - RoundReporting.uci
// Included via XangModGame.uci. Vars live in Game/Vars.uci; DefaultProperties in Game/Server.uci (last).
/**
 * True when this game mode should report round boundaries over RCON (opcodes 65-69).
 * LTS (many scored rounds per map) and TD/TO (one round == the map) are covered.
 * Everything else -- FFA, CTF, KOTH, Duel, CDWDuel, TUT, Survival -- is deliberately
 * excluded: their round semantics don't map cleanly to a start/end boundary. AOCTUT is a
 * AOCTeamObjective subclass, so it must be singled out or the tutorial would report too.
 */
function bool XangModRoundReportingEnabled()
{
    local AOCGame G;

    // Every gametype includes this file and they are all siblings under AOCGame, so a direct
    // AOCLTS(self) is an impossible downcast -- a hard compile error in every mode but LTS.
    // Going through an AOCGame local makes it a legal downcast, resolved at runtime.
    G = self;

    if (AOCLTS(G) != none)
        return true;
    if (AOCTD(G) != none)
        return true;
    if (AOCTeamObjective(G) != none && AOCTUT(G) == none)
        return true;
    return false;
}

/** Map an EAOCFaction to the int the client expects: 0 Agatha, 1 Mason, -1 none/draw. */
function int XangModRoundTeamIndex(EAOCFaction Faction)
{
    if (Faction == EFAC_AGATHA)
        return 0;
    if (Faction == EFAC_MASON)
        return 1;
    return -1;
}

/** Map name for round events, with a fallback so it is never empty. */
function string XangModRoundMapName()
{
    local string M;

    M = GetCurrentMap();
    if (M == "")
        M = WorldInfo.GetMapName();
    return M;
}

/**
 * The team that won the round just ended. For LTS this is AOCLTS.RoundWinner (the
 * AOCGame.WinningTeam member is only written by EndGame, so it is stale for a normal
 * per-round LTS end). TD/TO always route through EndGame, so WinningTeam is current there.
 */
function int XangModRoundWinnerTeamIndex()
{
    local AOCGame G;
    local AOCLTS LTS;

    G = self;
    LTS = AOCLTS(G);
    if (LTS != none)
    {
        if (LTS.RoundWinner != none)
            return LTS.RoundWinner.TeamIndex;
        return -1;
    }

    return XangModRoundTeamIndex(WinningTeam);
}

/** Current team scores and goal, source depends on mode (LTS vs the Teams[] mirror). */
function XangModRoundScores(out int AgathaScore, out int MasonScore, out int Goal)
{
    local AOCGame G;
    local AOCLTS LTS;

    G = self;
    LTS = AOCLTS(G);
    if (LTS != none)
    {
        if (LTS.RoundScores.Length > 0)
            AgathaScore = LTS.RoundScores[0];
        if (LTS.RoundScores.Length > 1)
            MasonScore = LTS.RoundScores[1];
        Goal = LTS.GoalScore;
        return;
    }

    if (Teams.Length > 0 && Teams[EFAC_AGATHA] != none)
        AgathaScore = Teams[EFAC_AGATHA].Score;
    if (Teams.Length > 1 && Teams[EFAC_MASON] != none)
        MasonScore = Teams[EFAC_MASON].Score;
    Goal = GoalScore;
}

/** Bracket the entire inherited pawn death path, including nested deaths. */
function XangModBeginDeathReport()
{
    XangModDeathDepth++;
}

function XangModFinishDeathReport()
{
    if (XangModDeathDepth > 0)
        XangModDeathDepth--;
    if (XangModDeathDepth == 0)
        XangModFlushRoundEnd();
}

/** Capture the boundary now; read player counters after the death path returns. */
function XangModSendRoundEnd(int WinningTeam, int MatchEnding)
{
    local int AgathaScore, MasonScore, Goal;

    // EndGame can be forced during warmup. It must not invent a round zero result.
    if (XangModRoundNumber < 1)
        return;

    if (bXangModRoundEndPending)
    {
        if (XangModPendingRoundNumber != XangModRoundNumber)
            XangModFlushRoundEnd();
        else if (XangModPendingMatchEnding == 1 || MatchEnding == 0)
            return;
        // A final EndGame on the same stack can promote a normal round end.
    }

    XangModRoundScores(AgathaScore, MasonScore, Goal);
    XangModPendingMap = XangModRoundMapName();
    XangModPendingRoundNumber = XangModRoundNumber;
    XangModPendingWinningTeam = WinningTeam;
    XangModPendingAgathaScore = AgathaScore;
    XangModPendingMasonScore = MasonScore;
    XangModPendingMatchEnding = MatchEnding;
    XangModPendingObjectiveReport.bValid = false;
    if (MatchEnding == 1)
        XangModPendingObjectiveReport = XangModCaptureObjectiveEnd();
    bXangModRoundEndPending = true;

    // Time limits and admin ends outside a death keep their immediate delivery.
    if (XangModDeathDepth == 0)
        XangModFlushRoundEnd();
}

/** Keep 69 (if present), 66, every 67, and 68 together on the same call stack. */
function XangModFlushRoundEnd()
{
    local XangModRCon RCon;

    if (!bXangModRoundEndPending)
        return;
    bXangModRoundEndPending = false;

    RCon = XangModRCon(RemoteConsole);
    if (RCon == none)
    {
        LogAlwaysInternal("[XangModRCon] Heir round result could not be sent: RemoteConsole is not XangModRCon");
        return;
    }

    XangModSendObjectiveReport(RCon, XangModPendingObjectiveReport);
    RCon.SendRoundEnd(XangModPendingWinningTeam, XangModPendingMap, XangModPendingRoundNumber,
        XangModPendingAgathaScore, XangModPendingMasonScore, XangModPendingMatchEnding);
    XangModSendRoundStats(RCon);
}

/**
 * 69: how one Team Objective stage ended. Stage is the 0-based index of that stage.
 * Outcome is 1 when the attackers completed it, 2 when a skip ended it (AdminSkipObjective
 * or the timed "ce skip"), 0 when the match ended with the stage still standing. The
 * running counts include this stage. Nothing is sent outside a real round, for the
 * tutorial, or for any other game mode.
 */
function XangModObjectiveReport XangModCaptureObjectiveStage(int Stage, bool bMatchEnd)
{
    local AOCGame G;
    local AOCTeamObjective TOGame;
    local XangModObjectiveReport Report;
    local int Outcome;

    // Same downcast route as XangModRoundReportingEnabled: through an AOCGame local.
    G = self;
    TOGame = AOCTeamObjective(G);
    if (TOGame == none || AOCTUT(G) != none || XangModRoundNumber < 1)
        return Report;
    if (Stage < 0 || Stage >= TOGame.AllObjectives.Length)
        return Report;

    // At match end the stage only counts when the map itself declared the attackers the
    // winners (ObjectiveEndGame sets TheWinningTeam). A time-out, or an admin ending the
    // match, leaves it standing.
    if (bMatchEnd && (TOGame.TheWinningTeam == EFAC_None || TOGame.TheWinningTeam != TOGame.AttackingTeam))
        Outcome = 0;
    else if (XangModObjSkipMark == Stage + 1)
        Outcome = 2;
    else
        Outcome = 1;

    if (Outcome == 1)
        XangModObjCompleted++;
    else if (Outcome == 2)
        XangModObjSkipped++;
    XangModObjSkipMark = 0;

    Report.bValid = true;
    Report.MapName = XangModRoundMapName();
    Report.RoundNumber = XangModRoundNumber;
    Report.Stage = Stage + 1;
    Report.TotalStages = TOGame.AllObjectives.Length;
    Report.Outcome = Outcome;
    Report.AttackingTeam = XangModRoundTeamIndex(TOGame.AttackingTeam);
    Report.Completed = XangModObjCompleted;
    Report.Skipped = XangModObjSkipped;
    Report.SecondsLeft = TOGame.TimeLeft;
    return Report;
}

function XangModSendObjectiveReport(XangModRCon RCon, XangModObjectiveReport Report)
{
    if (RCon == none || !Report.bValid)
        return;
    RCon.SendObjectiveStage(Report.MapName, Report.RoundNumber, Report.Stage, Report.TotalStages,
        Report.Outcome, Report.AttackingTeam, Report.Completed, Report.Skipped, Report.SecondsLeft);
}

function XangModSendObjectiveStage(int Stage, bool bMatchEnd)
{
    local XangModObjectiveReport Report;

    Report = XangModCaptureObjectiveStage(Stage, bMatchEnd);
    XangModSendObjectiveReport(XangModRCon(RemoteConsole), Report);
}

/** Capture the final TO stage before the remaining death callbacks can change it. */
function XangModObjectiveReport XangModCaptureObjectiveEnd()
{
    local AOCGame G;
    local AOCTeamObjective TOGame;
    local XangModObjectiveReport Report;

    G = self;
    TOGame = AOCTeamObjective(G);
    if (TOGame == none)
        return Report;

    return XangModCaptureObjectiveStage(TOGame.CurrentObjectiveStage, true);
}

/**
 * Clear every player's reported counters. Called from StartRound when round 1 begins, so
 * the cumulative 67 bursts cover the match and exclude whatever happened in the pre-round.
 */
function XangModResetRoundStats()
{
    local int i;
    local `{GAMEMODE}PRI ModPRI;

    if (WorldInfo == none || WorldInfo.GRI == none)
        return;

    for (i = 0; i < WorldInfo.GRI.PRIArray.Length; ++i)
    {
        ModPRI = `{GAMEMODE}PRI(WorldInfo.GRI.PRIArray[i]);
        if (ModPRI != none)
            ModPRI.XangModResetRoundStats();
    }
}

/** Walk every connected, non-bot player and push one 67 each, then a 68. */
function XangModSendRoundStats(XangModRCon RCon)
{
    local int i, Count;
    local `{GAMEMODE}PRI ModPRI;

    if (RCon == none || WorldInfo == none || WorldInfo.GRI == none)
    {
        if (RCon != none)
            RCon.SendRoundStatEnd(0);
        return;
    }

    for (i = 0; i < WorldInfo.GRI.PRIArray.Length; ++i)
    {
        ModPRI = `{GAMEMODE}PRI(WorldInfo.GRI.PRIArray[i]);
        if (ModPRI == none || ModPRI.bBot)
            continue;

        RCon.SendRoundPlayerStat(
            ModPRI.UniqueId.Uid,
            (ModPRI.Team != none) ? ModPRI.Team.TeamIndex : -1,
            ModPRI.PlayerName,
            ModPRI.NumKills,
            ModPRI.Deaths,
            ModPRI.NumAssists,
            int(ModPRI.Score),
            ModPRI.EnemyDamageDealt,
            ModPRI.RealTeamDamageDealt,
            ModPRI.AllDamageTaken,
            ModPRI.Parries,
            ModPRI.Feints,
            ModPRI.MeleeHits,
            ModPRI.ProjectileHits,
            ModPRI.Blocks,
            ModPRI.Dodges);
        Count++;
    }

    RCon.SendRoundStatEnd(Count);
}

